INPUT MAKEFILE
HEADERS = unused.h
CFLAGS = -O0
app: main.o helper.o
	gcc main.o helper.o -o app
main.o: main.c $(HEADERS)
	gcc $(CFLAGS) -c main.c -o main.o
helper.o: helper.c
	gcc $(CFLAGS) -c helper.c -o helper.o
.PHONY: clean
clean:
	rm -f main.o helper.o app

PATCH
--- a/Makefile
+++ b/Makefile
@@ -2,7 +2,7 @@
 CFLAGS = -O0
 app: main.o helper.o
 	gcc main.o helper.o -o app
-main.o: main.c $(HEADERS)
+main.o: main.c $(HEADERS) config.h
 	gcc $(CFLAGS) -c main.c -o main.o
 helper.o: helper.c
 	gcc $(CFLAGS) -c helper.c -o helper.o

PLAN [{'target': 'main.o', 'dependency': 'config.h', 'style': 'mixed'}]

STYLE_PASS mixed
STEP_EXIT_CODE=0
