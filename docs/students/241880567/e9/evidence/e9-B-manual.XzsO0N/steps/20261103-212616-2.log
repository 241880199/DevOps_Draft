INPUT MAKEFILE
DEPS = main.c unused.h
CFLAGS = -O0
app: main.o helper.o
	gcc main.o helper.o -o app
main.o: $(DEPS)
	gcc $(CFLAGS) -c main.c -o main.o
helper.o: helper.c
	gcc $(CFLAGS) -c helper.c -o helper.o
.PHONY: clean
clean:
	rm -f main.o helper.o app

PATCH
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,4 @@
-DEPS = main.c unused.h
+DEPS = main.c unused.h config.h
 CFLAGS = -O0
 app: main.o helper.o
 	gcc main.o helper.o -o app

PLAN [{'target': 'main.o', 'dependency': 'config.h', 'style': 'macro'}]

STYLE_PASS macro
STEP_EXIT_CODE=0
